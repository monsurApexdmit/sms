# Copy to .env for local development (docker-compose sets these itself).

# production refuses to start without a random SECRET_KEY, COOKIE_SECURE=true and REDIS_URL
ENVIRONMENT=development

DATABASE_URL=mysql+pymysql://sms:sms@127.0.0.1:3307/sms?charset=utf8mb4

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Optional in development: shared rate limits and the email/SMS job queue (needs a worker,
# see README). Without it notifications are sent in-process without retries.
# REDIS_URL=redis://127.0.0.1:6379/0

# argon2 (recommended) or sha1 (only while the old CodeIgniter app still logs users in)
PASSWORD_HASH_SCHEME=argon2

# Defaults to ../../uploads (the legacy uploads folder)
# UPLOAD_DIR=/path/to/uploads

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
SCHOOL_TIMEZONE=UTC
STRIPE_WEBHOOK_SECRET=
